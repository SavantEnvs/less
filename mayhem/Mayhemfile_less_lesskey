project: savantenvs/less
target: less_lesskey
testsuite:
  - https://$MAYHEM_DOMAIN/$MAYHEM_PROJECT/$MAYHEM_TARGET/testsuite.tar
  - file://mayhem/less_lesskey/testsuite
cmds:
  - cmd: /mayhem/mayhem/build-fuzz/less_t --tty /dev/null --lesskey-src @@ @@
    afl: true
    timeout: 5
    env:
      LESSSECURE: '1'
      LESSSECURE_ALLOW: lesskey
      LESSCHARSET: utf-8
      TERM: xterm
      LINES: '24'
      COLUMNS: '80'
      LESSHISTFILE: '-'
