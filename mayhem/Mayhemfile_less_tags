project: savantenvs/less
target: less_tags
testsuite:
  - https://$MAYHEM_DOMAIN/$MAYHEM_PROJECT/$MAYHEM_TARGET/testsuite.tar
  - file://mayhem/less_tags/testsuite
cmds:
  - cmd: /mayhem/mayhem/build-fuzz/less_env tags @@
    afl: true
    timeout: 5
    env:
      LESSSECURE: '1'
      LESSSECURE_ALLOW: tags
      LESSCHARSET: utf-8
      TERM: xterm
      LINES: '24'
      COLUMNS: '80'
      LESSHISTFILE: '-'
